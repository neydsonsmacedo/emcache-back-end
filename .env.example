POSTGRES_DB=emcache
POSTGRES_USER=dev_user
POSTGRES_PASSWORD=sua_senha_forte_aqui
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000

# Pluggy Open Finance (obtenha em https://dashboard.pluggy.ai)
PLUGGY_CLIENT_ID=seu_client_id_aqui
PLUGGY_CLIENT_SECRET=seu_client_secret_aqui
PLUGGY_WEBHOOK_URL=
PLUGGY_INCLUDE_SANDBOX=true

# LLM, Transcrição e Visão
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
TRANSCRIPTION_MODEL=whisper-1
VISION_MODEL=gpt-4o-mini

# Fallback de LLM (usado se a chamada ao modelo principal falhar)
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://api.openai.com/v1
LLM_FALLBACK_MODEL=gpt-4o-mini
LLM_FALLBACK_VISION_MODEL=gpt-4o-mini
LLM_FALLBACK_TRANSCRIPTION_MODEL=whisper-1
LLM_REQUEST_TIMEOUT_SECONDS=60
# Chave Fernet para criptografar API keys salvas por usuário:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_KEYS_ENCRYPTION_KEY=

# ElevenLabs Speech-to-Text (opcional; se preenchida, tem prioridade na transcrição de áudio)
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_TRANSCRIPTION_MODEL=scribe_v1

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
